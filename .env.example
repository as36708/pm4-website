# PM4 管理后台接收前台申请的服务端接口。
# 生产环境将此值配置为 Cloudflare Worker 的普通环境变量。
PM4_ADMIN_INGEST_URL=https://pm4-rebate-admin.chexin1103.chatgpt.site/api/frontend-ingest

# 下列两个值配置为 Cloudflare Worker 的 secret。
# PM4_ADMIN_SITES_BYPASS_TOKEN 用于 Worker 访问 Sites 上的管理后台，不是配置在前端浏览器或 Sites 项目中。
# 不要将真实密钥写进浏览器代码或提交到仓库。
PM4_ADMIN_INGEST_SECRET=
PM4_ADMIN_SITES_BYPASS_TOKEN=
